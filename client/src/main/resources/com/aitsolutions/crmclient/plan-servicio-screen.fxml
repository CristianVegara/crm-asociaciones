<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.aitsolutions.crmclient.plan.PlanServicioScreenController">
    <top><HBox spacing="10" alignment="CENTER_LEFT" styleClass="screen-header">
        <Label text="Planes de servicio" styleClass="screen-title"/>
        <ComboBox fx:id="comboPaciente" promptText="Paciente"/>
        <ComboBox fx:id="comboServicio" promptText="Servicio"/>
        <ComboBox fx:id="comboEstado" promptText="Estado"/>
        <Button text="Nuevo plan" onAction="#onNuevoPlanClick" styleClass="button-primary"/>
        <Label fx:id="etiquetaEstado" styleClass="status-label" HBox.hgrow="ALWAYS"/>
    </HBox></top>
    <center><TableView fx:id="tablaPlanes"/></center>
</BorderPane>
