<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.crm.asociaciones.backend</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/java</string>
        <string>-jar</string>
        <string>/opt/crm-asociaciones/crm-asociaciones-backend.jar</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/opt/crm-asociaciones</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/opt/crm-asociaciones/backend.log</string>
    <key>StandardErrorPath</key>
    <string>/opt/crm-asociaciones/backend-error.log</string>
</dict>
</plist>
