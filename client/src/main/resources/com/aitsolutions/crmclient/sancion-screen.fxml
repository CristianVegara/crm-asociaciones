<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.aitsolutions.crmclient.sancion.SancionScreenController">
    <top>
        <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="screen-header">
            <Label text="Sanciones" styleClass="screen-title"/>
            <TextField fx:id="campoPacienteId" promptText="Id del paciente"/>
            <Button text="Buscar" onAction="#onBuscarClick" styleClass="button-primary"/>
            <Label fx:id="etiquetaEstado" styleClass="status-label" HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tablaSanciones">
            <columns>
                <TableColumn fx:id="columnaFecha" text="Fecha" prefWidth="100.0"/>
                <TableColumn fx:id="columnaTipo" text="Tipo" prefWidth="180.0"/>
                <TableColumn fx:id="columnaMotivo" text="Motivo" prefWidth="260.0"/>
                <TableColumn fx:id="columnaAplicadaPor" text="Aplicada por" prefWidth="140.0"/>
                <TableColumn fx:id="columnaAutomatica" text="Automática" prefWidth="80.0"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10.0" styleClass="card">
            <padding>
                <Insets top="14.0" right="15.0" bottom="15.0" left="15.0"/>
            </padding>
            <Label text="Aplicar sanción manual" styleClass="card-title"/>
            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <ComboBox fx:id="comboTipoSancion" promptText="Tipo"/>
                <TextField fx:id="campoPlanServicioId" promptText="Id de plan (opcional)"/>
                <TextField fx:id="campoMotivo" promptText="Motivo" HBox.hgrow="ALWAYS"/>
                <Button text="Aplicar" onAction="#onAplicarClick" styleClass="button-primary"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
